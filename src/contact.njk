---
layout: page.njk
permalink: /contact/
eleventyComputed:
  title: "{{ staff.pageTitle }}"
  subtitle: "{{ staff.pageSubtitle }}"
---
<h2>{{ staff.contactHeading }}</h2>
<address>{{ site.street }}<br>{{ site.city }}</address>
<p>
{%- for l in staff.lines %}
{{ l.label }}: {% if l.kind == "phone" %}<a href="tel:{{ l.value | tel }}">{{ l.value }}</a>{% elif l.kind == "email" %}<a href="mailto:{{ l.value }}">{{ l.value }}</a>{% else %}{{ l.value }}{% endif %}{% if not loop.last %}<br>{% endif %}
{%- endfor %}
</p>

{% if staff.people | selectattr("show") | length %}
<h2>{{ staff.staffHeading }}</h2>
<ul class="contact-grid plain-list">
{%- for p in staff.people %}{% if p.show %}
  <li class="contact-card"><strong>{{ p.name }}</strong><br>{{ p.role }}</li>
{%- endif %}{% endfor %}
</ul>
{% endif %}

<h2 id="directions">{{ staff.directionsHeading }}</h2>
<p class="prose">{{ staff.directionsText }}</p>
<address>{{ staff.directionsPlace }}<br>{{ site.street }}<br>{{ site.city }}</address>
