---
layout: page.njk
permalink: /phone-numbers/
title: Important Phone Numbers
subtitle: In an emergency, dial 911.
---
<div class="phone-groups">
{%- for g in phones.groups %}
  <section class="phone-group" aria-labelledby="g{{ loop.index }}">
    <h2 id="g{{ loop.index }}">{{ g.name }}</h2>
    <dl>
    {%- for i in g.items %}
      <div><dt>{{ i.name }}</dt><dd>{% if i.number %}<a href="tel:{{ i.number | tel }}">{{ i.number }}</a>{% endif %}</dd></div>
    {%- endfor %}
    </dl>
  </section>
{%- endfor %}
</div>
{% if phones.note %}<p class="note">{{ phones.note }}</p>{% endif %}

{% if radio.items.length %}
<section class="phone-group radio-group" aria-labelledby="radio-title">
  <h2 id="radio-title">{{ radio.title }}</h2>
  <dl>
  {%- for r in radio.items %}
    <div><dt>{{ r.name }}</dt><dd>{{ r.freq }}</dd></div>
  {%- endfor %}
  </dl>
</section>
{% endif %}
