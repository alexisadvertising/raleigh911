---
layout: page.njk
permalink: /phone-numbers/
title: Important Phone Numbers
subtitle: In an emergency, dial 911.
---
<div class="phone-groups">
{%- for g in phones.groups %}
  <section class="phone-group" aria-labelledby="g{{ loop.index }}">
    <h2 id="g{{ loop.index }}">{{ g.name }}</h2>
    <dl>
    {%- for i in g.items %}
      <div><dt>{{ i.name }}</dt><dd><a href="tel:{{ i.number | tel }}">{{ i.number }}</a></dd></div>
    {%- endfor %}
    </dl>
  </section>
{%- endfor %}
</div>
