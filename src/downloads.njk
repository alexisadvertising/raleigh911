---
layout: page.njk
permalink: /downloads/
eleventyComputed:
  title: "{{ downloads.pageTitle }}"
  subtitle: "{{ downloads.pageSubtitle }}"
---
{% if downloads.items.length %}
<ul class="plain-list link-list prose">
{%- for d in downloads.items %}{% set href = d.url or d.file %}{% if href %}<li><a href="{{ href }}">{{ d.title }}</a>{% if d.note %} <span>({{ d.note }})</span>{% endif %}</li>{% endif %}{%- endfor %}
</ul>
{% else %}
<p>{{ downloads.emptyText }} For anything you need now, call <a href="tel:{{ site.nonEmergency | tel }}">{{ site.nonEmergency }}</a>.</p>
{% endif %}
