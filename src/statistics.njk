---
layout: page.njk
permalink: /statistics/
eleventyComputed:
  title: "{{ stats.pageTitle }}"
  subtitle: "{{ stats.pageSubtitle }}"
---
<h2>{{ stats.openingHeading }}</h2>
{% if stats.intro %}<p class="stat-lead">{{ stats.intro }}</p>{% endif %}

<h2>{{ stats.totalHeading }}</h2>
{% set mx = stats | maxtotal %}
<div class="bars" role="img" aria-label="Bar chart of total dispatches per year. The full numbers are in the tables below.">
{%- for y in stats.years %}
  {% set t = stats | total(loop.index0) %}
  <div class="bar-row"><span>{{ y }}</span><span class="bar-track"><span class="bar-fill" style="display:block;width:{{ t | pct(mx) }}%"></span></span><span>{{ t | num }}</span></div>
{%- endfor %}
</div>

{% set last = stats.years.length - 1 %}
{% set prev = last - 1 %}
{% set amx = 0 %}
{%- for s in stats.series %}{% if s.values[last] > amx %}{% set amx = s.values[last] %}{% endif %}{% if s.values[prev] > amx %}{% set amx = s.values[prev] %}{% endif %}{%- endfor %}
<h2>{{ stats.agencyHeading }}, {{ stats.years[prev] }}–{{ stats.years[last] }}</h2>
{% if stats.agencyIntro %}<p>{{ stats.agencyIntro }}</p>{% endif %}
<p class="chart-key"><span><i class="is-prior"></i>{{ stats.years[prev] }}</span><span><i></i>{{ stats.years[last] }}</span></p>
<div class="bars bars-agency" role="img" aria-label="Bar chart comparing {{ stats.years[prev] }} and {{ stats.years[last] }} dispatches for each agency type. The full numbers are in the table below.">
{%- for s in stats.series %}
  <div class="agency-name">{{ s.name }}</div>
  <div class="bar-row"><span>{{ stats.years[prev] }}</span><span class="bar-track"><span class="bar-fill is-prior" style="display:block;width:{{ s.values[prev] | pct(amx) }}%"></span></span><span>{{ s.values[prev] | num }}</span></div>
  <div class="bar-row"><span>{{ stats.years[last] }}</span><span class="bar-track"><span class="bar-fill" style="display:block;width:{{ s.values[last] | pct(amx) }}%"></span></span><span>{{ s.values[last] | num }}</span></div>
{%- endfor %}
</div>

<h2>{{ stats.typeHeading }}</h2>
<div class="table-wrap">
<table class="data">
  <thead><tr><th scope="col">Year</th>{% for s in stats.series %}<th scope="col" class="n">{{ s.name }}</th>{% endfor %}</tr></thead>
  <tbody>
  {%- for y in stats.years %}
    {% set i = loop.index0 %}
    <tr><th scope="row">{{ y }}</th>{% for s in stats.series %}<td class="n">{{ s.values[i] | num }}</td>{% endfor %}</tr>
  {%- endfor %}
  </tbody>
</table>
</div>
