---
layout: base.njk
---
<div class="page-head"><div class="wrap">
  <h1>{{ title }}</h1>
  {% if subtitle %}<p class="page-sub">{{ subtitle }}</p>{% endif %}
</div></div>
<div class="wrap page-body">
  {% if heroImage %}<figure class="page-figure"><img src="{{ heroImage }}" alt="{{ heroAlt }}"></figure>{% endif %}
  <div class="prose">
    {{ content | safe }}
    {% if form and (form.url or form.help) %}
      <p class="form-cta">
        {% if form.url %}<a class="btn btn-solid" href="{{ form.url }}">{{ form.label or "Open the form" }}</a>
        {% else %}{{ form.help }} <a href="tel:{{ (form.phone or site.nonEmergency) | tel }}">{{ form.phone or site.nonEmergency }}</a>.{% endif %}
      </p>
    {% endif %}
  </div>
</div>
