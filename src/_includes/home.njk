---
layout: base.njk
---
{% if notice.show %}
<div class="notice-bar" role="region" aria-label="Public notice"><div class="wrap"><strong>{{ notice.title }}:</strong> {{ notice.text }}</div></div>
{% endif %}
<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <h1 id="hero-title">{{ home.hero.title }}</h1>
      <p class="hero-lead">{{ home.hero.lead }}</p>
      {% if home.hero.buttons.length %}
      <ul class="button-row">
        {%- for b in home.hero.buttons %}
        <li><a class="btn {% if loop.first %}btn-primary{% else %}btn-secondary{% endif %}" href="{{ b.url }}">{{ b.label }}</a></li>
        {%- endfor %}
      </ul>
      {% endif %}
    </div>
    {% if home.hero.image %}
    <figure class="hero-figure">
      <img src="{{ home.hero.image }}" alt="{{ home.hero.imageAlt }}">
    </figure>
    {% endif %}
  </div>
</section>

<div class="wrap layout">
  <div class="content">
    <section aria-labelledby="welcome-title">
      <h2 id="welcome-title">{{ home.letterHeading }}</h2>
      <div class="prose">{{ content | safe }}</div>
    </section>

    <section aria-labelledby="services-title">
      <h2 id="services-title">{{ home.services.heading }}</h2>
      <p>{{ home.services.text }}</p>
      <ul class="card-grid">
        {%- for c in home.services.cards %}
        <li class="card"><h3>{{ c.title }}</h3><p>{{ c.text }}</p>{% if c.link %}<a href="{{ c.link }}">{{ c.linkText }}</a>{% endif %}</li>
        {%- endfor %}
      </ul>
    </section>

    <section aria-labelledby="numbers-title">
      <h2 id="numbers-title">{{ home.glance.heading }}</h2>
      <dl class="stat-list">
        {%- for s in home.glance.items %}
        <div class="stat"><dt>{{ s.label }}</dt><dd>{{ s.value }}</dd></div>
        {%- endfor %}
      </dl>
      {% if home.glance.linkUrl %}<p class="note"><a href="{{ home.glance.linkUrl }}">{{ home.glance.linkText }}</a></p>{% endif %}
    </section>

    {% if home.resource.show and (home.resource.formUrl or home.resource.pdf) %}
    <section aria-labelledby="resource-title">
      <h2 id="resource-title">{{ home.resource.heading }}</h2>
      <p>{{ home.resource.text }}</p>
      <p>
        {% if home.resource.formUrl %}<a class="btn btn-solid" href="{{ home.resource.formUrl }}">{{ home.resource.formLabel or "Fill out the form online" }}</a>{% endif %}
        {% if home.resource.pdf %}<a class="btn {% if home.resource.formUrl %}btn-outline{% else %}btn-solid{% endif %}" href="{{ home.resource.pdf }}">{{ home.resource.pdfLabel or "Download the form (PDF)" }}</a>{% endif %}
      </p>
    </section>
    {% endif %}
  </div>

  <aside class="sidebar" aria-label="Quick information">
    <section class="panel" aria-labelledby="quick-title">
      <h2 id="quick-title">{{ home.sidebar.phonesHeading }}</h2>
      <dl class="number-list">
        {%- for n in home.sidebar.numbers %}
        <div><dt>{{ n.label }}</dt><dd><a {% if loop.first %}class="strong-link" {% endif %}href="tel:{{ n.number | tel }}">{{ n.number }}</a></dd></div>
        {%- endfor %}
      </dl>
      <p><a href="/phone-numbers/">{{ home.sidebar.phonesLinkText }}</a></p>
    </section>

    <section class="panel" aria-labelledby="board-title">
      <h2 id="board-title">{{ home.sidebar.boardHeading }}</h2>
      <p>Meetings begin at <strong>{{ board.time }}</strong>{% if not board.time.endsWith('.') %}.{% endif %} {{ board.extraNote }}</p>
      <ul class="plain-list" data-next-meetings>
        {%- for m in board.meetings %}
        <li data-date="{{ m.date }}">{{ m.date | longdate }}{% if m.note %} ({{ m.note }}){% endif %}</li>
        {%- endfor %}
      </ul>
      <p data-no-meetings hidden>See the Board page for the schedule.</p>
      <p><a href="/board/">{{ home.sidebar.boardLinkText }}</a></p>
    </section>

    <section class="panel" aria-labelledby="visit-title">
      <h2 id="visit-title">{{ home.sidebar.visitHeading }}</h2>
      <address>{{ site.shortName }}<br>{{ site.street }}<br>{{ site.city }}</address>
      <p><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
      <p><a href="/contact/#directions">{{ home.sidebar.directionsLinkText }}</a></p>
    </section>

    {% if social.facebookUrl and social.showFeed %}
    <section class="panel" aria-labelledby="fb-title">
      <h2 id="fb-title">{{ home.sidebar.facebookHeading }}</h2>
      <iframe class="fb-feed" title="Facebook posts from {{ site.shortName }}" loading="lazy" height="500" width="340"
        src="https://www.facebook.com/plugins/page.php?href={{ social.facebookUrl | urlencode }}&amp;tabs=timeline&amp;width=340&amp;height=500&amp;small_header=true&amp;hide_cover=true&amp;show_facepile=false"></iframe>
      <p><a href="{{ social.facebookUrl }}">{{ home.sidebar.facebookLinkText }}</a></p>
    </section>
    {% endif %}

    <section class="panel" aria-labelledby="links-title">
      <h2 id="links-title">{{ home.sidebar.linksHeading }}</h2>
      <ul class="plain-list link-list">
        {%- for l in links.links | head(links.homeCount or 5) %}<li><a href="{{ l.url }}">{{ l.name }}</a></li>{%- endfor %}
      </ul>
      <p><a href="/links/">{{ home.sidebar.linksLinkText }}</a></p>
    </section>
  </aside>
</div>
