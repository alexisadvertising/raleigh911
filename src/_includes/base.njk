<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% if title and page.url != "/" %}{{ title }} | {% endif %}Raleigh County 911 &amp; Emergency Services</title>
  <meta name="description" content="{{ description or 'Official website of the Raleigh County Emergency Services Authority: 911 dispatch, addressing and street signs, alarm monitoring, and emergency management for Beckley and Raleigh County, WV.' }}">
  <link rel="icon" href="/images/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <a class="skip-link" href="#main">Skip to main content</a>

  <div class="emergency-bar" role="region" aria-label="Emergency notice">
    <p><strong>{{ site.emergencyText }}</strong> For non-emergencies, call <a href="tel:{{ site.nonEmergency | tel }}">{{ site.nonEmergency }}</a>.</p>
  </div>

  <header class="site-header">
    <div class="wrap header-row">
      <a class="brand" href="/">
        <img class="brand-logo" src="/images/logo-white.png" alt="" height="84">
        <span class="brand-text">
          <span class="brand-name">{{ site.shortName }}</span>
          <span class="brand-sub">{{ site.tagline }}</span>
        </span>
      </a>
      <details class="menu" id="site-menu">
        <summary><span class="menu-icon" aria-hidden="true"></span><span>Menu</span></summary>
        <nav class="menu-panel" aria-label="Main">
          <ul>
            {%- set items = [["/","Home"],["/about/","About the EOC"],["/addressing/","Addressing & Signs"],["/telecommunicators/","Dispatch"],["/lepc/","LEPC"],["/board/","Board of Directors"],["/community/","Community"],["/photos/","Photos"],["/statistics/","Statistics"],["/phone-numbers/","Phone Numbers"],["/links/","Links"],["/downloads/","Downloads"],["/contact/","Contact"]] -%}
            {%- for i in items %}
            <li><a href="{{ i[0] }}"{% if page.url == i[0] %} aria-current="page"{% endif %}>{{ i[1] }}</a></li>
            {%- endfor %}
          </ul>
        </nav>
      </details>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="site-footer">
    <div class="wrap footer-grid">
      <div>
        <h2 class="footer-title">{{ site.name }}</h2>
        <address>
          {{ site.street }}<br>{{ site.city }}<br>
          <a href="tel:{{ site.nonEmergency | tel }}">{{ site.nonEmergency }}</a><br>
          <a href="mailto:{{ site.email }}">{{ site.email }}</a>
        </address>
      </div>
      <nav aria-label="Footer">
        <h2 class="footer-title">More</h2>
        <ul class="plain-list">
          <li><a href="/downloads/">Downloads</a></li>
          <li><a href="/links/">Links</a></li>
          <li><a href="/terms/">Terms of use &amp; site policy</a></li>

        </ul>
      </nav>
      <div>
        <h2 class="footer-title">In an emergency</h2>
        <p class="footer-911">Dial <strong>911</strong></p>
        <p>From any phone, any time. Stay on the line and follow the telecommunicator&rsquo;s instructions.</p>
      </div>
    </div>
    {% if social.facebookUrl %}
    <p class="wrap footer-social"><a class="fb-link" href="{{ social.facebookUrl }}">
      <svg class="fb-icon" viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" focusable="false"><path fill="currentColor" d="M9.101 23.691v-7.98H6.627v-3.667h2.474v-1.58c0-4.085 1.848-5.978 5.858-5.978.401 0 .955.042 1.468.103a8.68 8.68 0 0 1 1.141.195v3.325a8.623 8.623 0 0 0-.653-.036 26.805 26.805 0 0 0-.733-.009c-.707 0-1.259.096-1.675.309a1.686 1.686 0 0 0-.679.622c-.258.42-.374.995-.374 1.752v1.297h3.919l-.386 2.103-.287 1.564h-3.246v8.245C19.396 23.238 24 18.179 24 12.044c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.628 3.874 10.35 9.101 11.647Z"/></svg>
      <span>Follow us on Facebook</span></a></p>
    {% endif %}
    <p class="wrap legal">&copy; {{ build.year }} {{ site.name }}. Established 1982 by House Bill 2108.</p>
  </footer>
  <script src="/js/site.js" defer></script>
</body>
</html>
